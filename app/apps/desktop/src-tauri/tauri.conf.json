{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CryptoUpload",
  "version": "0.1.0-beta.1",
  "identifier": "io.cryptoupload.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "CryptoUpload",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "CryptoUpload",
    "copyright": "Copyright © 2026 CryptoUpload. License: GPL-3.0-or-later with an app store exception",
    "category": "Utility",
    "shortDescription": "Zero-knowledge encrypted vault and cloud backup",
    "longDescription": "CryptoUpload encrypts your files before they leave your device, using the open Unified Vault Format (UVF). It works with Google Drive, Dropbox, OneDrive, S3-compatible storage, SFTP and WebDAV. Automatic folder backup and manual upload. No proprietary backend, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp",
        "languages": ["English", "Arabic", "German", "Spanish", "French", "Italian", "Japanese", "PortugueseBR", "Russian", "SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libglib2.0-0", "libayatana-appindicator3-1"],
        "recommends": ["fuse3"],
        "section": "utils",
        "priority": "optional"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxN0ZEOUYxNkQ4RkQ0RUQKUldUdDFJOXQ4ZGwvd1RJc1RaLzVDNjdQMU0rb3ZJSmJKZlMxZHJrSlJWbmJZWHBsZ1VQTFJRdmIK",
      "endpoints": [
        "https://github.com/cryptoupload/CryptoUpload/releases/latest/download/latest.json"
      ]
    }
  }
}
