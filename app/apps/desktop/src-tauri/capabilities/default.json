{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "main-*"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "mailto:translations@cryptoupload.org?*"
        },
        {
          "url": "mailto:info@cryptoupload.org?*"
        },
        {
          "url": "https://github.com/cryptoupload/CryptoUpload/issues/new?*"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "notification:default"
  ]
}
